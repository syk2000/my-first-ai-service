{
  "functions": {
    "api/kakao.js": {
      "includeFiles": "company-homepage/assets/spec-data.js"
    }
  },
  "headers": [
    {
      "source": "/company-homepage/(.*)\\.(webp|png|jpg|jpeg|gif|svg|ico|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/company-homepage/(.*)\\.(js|css)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
