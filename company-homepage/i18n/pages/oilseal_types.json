건)</span>":"TC型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(159项)</span>","SC형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(4건)</span>":"SC型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(4项)</span>","D형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(151건)</span>":"D型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(151项)</span>","DM형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(19건)</span>":"DM型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(19项)</span>","DA형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(3건)</span>":"DA型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(3项)</span>","S형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(36건)</span>":"S型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(36项)</span>","SM형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(17건)</span>":"SM型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(17项)</span>","SA형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(6건)</span>":"SA型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(6项)</span>","SB형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(1건)</span>":"SB型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(1项)</span>","V형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(2건)</span>":"V型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(2项)</span>","VB형 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">(29건)</span>":"VB型 <span style=\"font-size: 12.5px; color: var(--text-sub); font-weight: 400;\">