    "en": {
      "\n        <svg class=\"logo-mark\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n          <circle cx=\"20\" cy=\"20\" r=\"17\" stroke=\"#c98a2b\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"20\" r=\"8.5\" stroke=\"#4f7fb3\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"7\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"20\" cy=\"33\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n        </svg>\n        <span class=\"company-name\">\n          [회사명] 베어링\n          <span class=\"sub\">BEARING DISTRIBUTION</span>\n        </span>\n      ": "\n        <svg class=\"logo-mark\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n          <circle cx=\"20\" cy=\"20\" r=\"17\" stroke=\"#c98a2b\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"20\" r=\"8.5\" stroke=\"#4f7fb3\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"7\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"20\" cy=\"33\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n        </svg>\n        <span class=\"company-name\">\n          [Company Name] Bearing\n          <span class=\"sub\">BEARING DISTRIBUTION</span>\n        </span>\n      ",
