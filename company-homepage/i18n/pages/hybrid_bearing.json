{"text":{"en":{"\n        <svg class=\"logo-mark\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n          <circle cx=\"20\" cy=\"20\" r=\"17\" stroke=\"#c98a2b\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"20\" r=\"8.5\" stroke=\"#4f7fb3\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"7\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"20\" cy=\"33\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n        </svg>\n        <span class=\"company-name\">\n          [회사명] 베어링\n          <span class=\"sub\">BEARING DISTRIBUTION</span>\n        </span>\n      ":"\n        <svg class=\"logo-mark\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n          <circle cx=\"20\" cy=\"20\" r=\"17\" stroke=\"#c98a2b\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"20\" r=\"8.5\" stroke=\"#4f7fb3\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"7\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"20\" cy=\"33\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n        </svg>\n        <span class=\"company-name\">\n          [Company Name] Bearing\n          <span class=\"sub\">BEARING DISTRIBUTION</span>\n        </span>\n      ","회사소개":"Company","\n            <a href=\"introduce.html#greeting\">인사말</a>\n            <a href=\"introduce.html#history\">연혁</a>\n            <a href=\"introduce.html#directions\">찾아오시는 길</a>\n          ":"\n            <a href=\"introduce.html#greeting\">Greeting</a>\n            <a href=\"introduce.html#history\">History</a>\n            <a href=\"introduce.html#directions\">Directions</a>\n          ","취급제품":"Products","\n            <a href=\"about-product.html#bearing-group\">베어링</a>\n            <a href=\"about-product.html#accessory-group\">부속 부품</a>\n            <a href=\"brands.html\">취급 브랜드</a>\n          ":"\n            <a href=\"about-product.html#bearing-group\">Bearings</a>\n            <a href=\"about-product.html#accessory-group\">Accessory Parts</a>\n            <a href=\"brands.html\">Brands</a>\n          ","규격검색":"Spec Search","고객센터":"Support","\n            <a href=\"notice.html\">공지사항</a>\n            <a href=\"catalog.html\">카탈로그</a>\n            <a href=\"board.html\">견적문의</a>\n          ":"\n            <a href=\"notice.html\">Notices</a>\n            <a href=\"catalog.html\">Catalog</a>\n            <a href=\"board.html\">Quote Inquiry</a>\n          ","\n          <a href=\"board.html\" class=\"btn btn-accent btn-sm\">견적 문의하기</a>\n        ":"\n          <a href=\"board.html\" class=\"btn btn-accent btn-sm\">Request a Quote</a>\n        ","\n        <p class=\"eyebrow\">Hybrid Bearings</p>\n        <h2>하이브리드 베어링</h2>\n        <p>\n          전동체(볼)만 비금속 소재로 바꾼 베어링으로, 전기 절연성·경량화·저마찰·내식성이 필요한 용도에 사용합니다.\n          아래 형번들은 일반 규격품과 함께 <strong style=\"color: var(--accent);\">당사가 표준으로 재고 보유하는 하이브리드 사양</strong>입니다.\n        </p>\n      ":"\n        <p class=\"eyebrow\">Hybrid Bearings</p>\n        <h2>Hybrid Bearings</h2>\n        <p>\n          A bearing in which only the rolling elements (balls) are changed to a non-metallic material, used in applications that require electrical insulation, weight reduction, low friction, and corrosion resistance.\n          The model numbers below are hybrid specifications that <strong style=\"color: var(--accent);\">we keep in standard stock</strong> alongside our regular standard products.\n        </p>\n      ","형태 참고용 개념도 (SWS 카탈로그 실측 도면 아님) — 전동체(볼)만 비금속 소재로 교체한 구조, 정면도·측면도 측정 위치":"Concept diagram for form reference only (not an actual-measurement drawing from the SWS catalog) — structure with only the rolling elements (balls) replaced with a non-metallic material; front-view and side-view measurement locations","\n        <img src=\"img/deep_groove_ball_open.png\" alt=\"일반 볼 베어링(개방형) 규격 도면 — D(외경)·d(내경)·B(폭) 측정 위치\" style=\"display: block; height: 208px; width: auto; max-width: 100%; object-fit: contain; image-rendering: -webkit-optimize-contrast;\" loading=\"lazy\">\n        <svg viewBox=\"0 0 375 236\" width=\"330\" height=\"208\" style=\"display: block;\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <circle cx=\"130\" cy=\"118\" r=\"78\" stroke=\"#333\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"130\" cy=\"118\" r=\"42\" stroke=\"#333\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"130\" cy=\"46\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"183\" cy=\"65\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"202\" cy=\"118\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"183\" cy=\"171\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"130\" cy=\"190\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"77\" cy=\"171\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"58\" cy=\"118\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"77\" cy=\"65\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <line x1=\"183\" y1=\"65\" x2=\"245\" y2=\"32\" stroke=\"#666\" stroke-width=\"1\"></line>\n          <text x=\"249\" y=\"24\" font-size=\"12.5\" fill=\"#333\" font-weight=\"600\">전동체(볼)</text>\n          <text x=\"249\" y=\"39\" font-size=\"11\" fill=\"#555\">세라믹·PEEK·</text>\n          <text x=\"249\" y=\"52\" font-size=\"11\" fill=\"#555\">플라스틱 중 선택</text>\n          <line x1=\"202\" y1=\"118\" x2=\"245\" y2=\"118\" stroke=\"#666\" stroke-width=\"1\"></line>\n          <text x=\"249\" y=\"114\" font-size=\"12.5\" fill=\"#333\" font-weight=\"600\">내외륜·리테이너</text>\n          <text x=\"249\" y=\"129\" font-size=\"11\" fill=\"#555\">STB2강(표준과 동일)</text>\n          <g stroke=\"#666\" stroke-width=\"1\">\n            <line x1=\"52\" y1=\"118\" x2=\"52\" y2=\"16\"></line>\n            <line x1=\"208\" y1=\"118\" x2=\"208\" y2=\"16\"></line>\n            <line x1=\"52\" y1=\"16\" x2=\"208\" y2=\"16\" marker-start=\"url(#hybArrow)\" marker-end=\"url(#hybArrow)\"></line>\n          </g>\n          <text x=\"130\" y=\"12\" text-anchor=\"middle\" font-size=\"14\" fill=\"#333\" font-weight=\"600\">D</text>\n          <g stroke=\"#666\" stroke-width=\"1\">\n            <line x1=\"88\" y1=\"118\" x2=\"88\" y2=\"220\"></line>\n            <line x1=\"172\" y1=\"118\" x2=\"172\" y2=\"220\"></line>\n            <line x1=\"88\" y1=\"220\" x2=\"172\" y2=\"220\" marker-start=\"url(#hybArrow)\" marker-end=\"url(#hybArrow)\"></line>\n          </g>\n          <text x=\"130\" y=\"233\" text-anchor=\"middle\" font-size=\"14\" fill=\"#333\" font-weight=\"600\">d</text>\n          <defs>\n            <marker id=\"hybArrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"3\" refY=\"3\" orient=\"auto\">\n              <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"#666\"></path>\n            </marker>\n          </defs>\n        </svg>\n        ":"\n        <img src=\"img/deep_groove_ball_open.png\" alt=\"Standard ball bearing (open type) spec drawing — D (O.D.)·d (Bore)·B (Width) measurement locations\" style=\"display: block; height: 208px; width: auto; max-width: 100%; object-fit: contain; image-rendering: -webkit-optimize-contrast;\" loading=\"lazy\">\n        <svg viewBox=\"0 0 375 236\" width=\"330\" height=\"208\" style=\"display: block;\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <circle cx=\"130\" cy=\"118\" r=\"78\" stroke=\"#333\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"130\" cy=\"118\" r=\"42\" stroke=\"#333\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"130\" cy=\"46\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"183\" cy=\"65\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"202\" cy=\"118\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"183\" cy=\"171\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"130\" cy=\"190\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"77\" cy=\"171\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"58\" cy=\"118\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"77\" cy=\"65\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <line x1=\"183\" y1=\"65\" x2=\"245\" y2=\"32\" stroke=\"#666\" stroke-width=\"1\"></line>\n          <text x=\"249\" y=\"24\" font-size=\"12.5\" fill=\"#333\" font-weight=\"600\">Rolling Element (Ball)</text>\n          <text x=\"249\" y=\"39\" font-size=\"11\" fill=\"#555\">Ceramic · PEEK ·</text>\n          <text x=\"249\" y=\"52\" font-size=\"11\" fill=\"#555\">or Plastic</text>\n          <line x1=\"202\" y1=\"118\" x2=\"245\" y2=\"118\" stroke=\"#666\" stroke-width=\"1\"></line>\n          <text x=\"249\" y=\"114\" font-size=\"12.5\" fill=\"#333\" font-weight=\"600\">Inner/Outer Ring & Retainer (Cage)</text>\n          <text x=\"249\" y=\"129\" font-size=\"11\" fill=\"#555\">STB2 Steel (same as standard)</text>\n          <g stroke=\"#666\" stroke-width=\"1\">\n            <line x1=\"52\" y1=\"118\" x2=\"52\" y2=\"16\"></line>\n            <line x1=\"208\" y1=\"118\" x2=\"208\" y2=\"16\"></line>\n            <line x1=\"52\" y1=\"16\" x2=\"208\" y2=\"16\" marker-start=\"url(#hybArrow)\" marker-end=\"url(#hybArrow)\"></line>\n          </g>\n          <text x=\"130\" y=\"12\" text-anchor=\"middle\" font-size=\"14\" fill=\"#333\" font-weight=\"600\">D</text>\n          <g stroke=\"#666\" stroke-width=\"1\">\n            <line x1=\"88\" y1=\"118\" x2=\"88\" y2=\"220\"></line>\n            <line x1=\"172\" y1=\"118\" x2=\"172\" y2=\"220\"></line>\n            <line x1=\"88\" y1=\"220\" x2=\"172\" y2=\"220\" marker-start=\"url(#hybArrow)\" marker-end=\"url(#hybArrow)\"></line>\n          </g>\n          <text x=\"130\" y=\"233\" text-anchor=\"middle\" font-size=\"14\" fill=\"#333\" font-weight=\"600\">d</text>\n          <defs>\n            <marker id=\"hybArrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"3\" refY=\"3\" orient=\"auto\">\n              <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"#666\"></path>\n            </marker>\n          </defs>\n        </svg>\n        ","왼쪽은 일반 볼 베어링(개방형) 실제 규격 도면입니다 — D(외경)·d(내경)·B(폭) 측정 위치가 표시되어 있으며, 오른쪽은 하이브리드 구조 개념도입니다. 하이브리드 사양도 전동체(볼) 소재만 다를 뿐 외형 치수는 동일합니다. 전동체(볼)만 비금속 소재로 교체되며, 내외륜·리테이너는 일반 규격품과 동일(STB2강)입니다.":"On the left is the actual spec drawing of a standard ball bearing (open type) — showing the D (O.D.)·d (Bore)·B (Width) measurement locations; on the right is a concept diagram of the hybrid structure. The hybrid specification differs only in the rolling element (ball) material, with the same outer dimensions. Only the rolling elements (balls) are replaced with a non-metallic material, while the inner/outer rings and retainer (cage) are the same as the standard product (STB2 steel).","\n        <strong>전동체(볼) 소재 종류</strong><br>\n        세라믹(풀세라믹 ZrO2) · PEEK 하이브리드 · 플라스틱(POM) 하이브리드<br>\n        <span style=\"color: var(--text-faint); font-size: 12.5px;\">내외륜·리테이너는 일반 사양과 동일(STB2강)이며, 볼만 교체한 사양입니다. 가격은 소재·수량에 따라 견적 문의로 안내해드립니다.</span>\n      ":"\n        <strong>Rolling Element (Ball) Material Types</strong><br>\n        Ceramic (full ceramic ZrO2) · PEEK Hybrid · Plastic (POM) Hybrid<br>\n        <span style=\"color: var(--text-faint); font-size: 12.5px;\">The inner/outer rings and retainer (cage) are the same as the standard specification (STB2 steel); only the balls are replaced. Pricing depends on material and quantity, and will be provided via quote inquiry.</span>\n      ","\n        <button type=\"button\" class=\"cat-tab-btn active\" data-tab=\"hmini\">미니어처 볼 베어링</button>\n        <button type=\"button\" class=\"cat-tab-btn\" data-tab=\"hdg\">딥그루브 볼 베어링</button>\n        <button type=\"button\" class=\"cat-tab-btn\" data-tab=\"hsa\">자동조심 볼 베어링</button>\n      ":"\n        <button type=\"button\" class=\"cat-tab-btn active\" data-tab=\"hmini\">Miniature Ball Bearings</button>\n        <button type=\"button\" class=\"cat-tab-btn\" data-tab=\"hdg\">Deep Groove Ball Bearings</button>\n        <button type=\"button\" class=\"cat-tab-btn\" data-tab=\"hsa\">Self-Aligning Ball Bearings</button>\n      ","미니어처 볼 베어링(<a href=\"miniature_ball.html\" style=\"color: var(--accent);\">miniature_ball.html</a>) 중 604·624·684·694 네 계열, 각 호칭 8번까지 세라믹·PEEK·플라스틱 하이브리드로 표준 재고를 보유합니다.":"Of the Miniature Ball Bearings (<a href=\"miniature_ball.html\" style=\"color: var(--accent);\">miniature_ball.html</a>), we keep standard stock in ceramic, PEEK, and plastic hybrid versions for the four series 604·624·684·694, up to size No. 8 for each.","604 시리즈 (표준폭)<span class=\"series-count\">5건</span>":"604 Series (Standard Width)<span class=\"series-count\">5 items</span>","형번":"Model No.","d(내경)":"d (Bore)","D(외경)":"D (O.D.)","B(폭)":"B (Width)","하이브리드 소재":"Hybrid Material","624 시리즈 (광폭)<span class=\"series-count\">5건</span>":"624 Series (Wide Width)<span class=\"series-count\">5 items</span>","684 시리즈 (초박형)<span class=\"series-count\">5건</span>":"684 Series (Extra-Thin)<span class=\"series-count\">5 items</span>","694 시리즈 (박형)<span class=\"series-count\">5건</span>":"694 Series (Thin)<span class=\"series-count\">5 items</span>","단위: mm · 치수는 miniature_ball.html의 동일 형번 규격과 같습니다.":"Unit: mm · Dimensions are the same as the corresponding model numbers' specifications on miniature_ball.html.","딥그루브 볼 베어링(<a href=\"deep_groove_ball.html\" style=\"color: var(--accent);\">deep_groove_ball.html</a>) 중 6000·6200·6800·6900 네 계열, 각 12번까지 세라믹·PEEK·플라스틱 하이브리드로 표준 재고를 보유합니다(그 이상 호칭은 주문제작).":"Of the Deep Groove Ball Bearings (<a href=\"deep_groove_ball.html\" style=\"color: var(--accent);\">deep_groove_ball.html</a>), we keep standard stock in ceramic, PEEK, and plastic hybrid versions for the four series 6000·6200·6800·6900, up to size No. 12 for each (larger sizes are made to order).","6000 시리즈 (표준)<span class=\"series-count\">13건</span>":"6000 Series (Standard)<span class=\"series-count\">13 items</span>","6200 시리즈 (중하중)<span class=\"series-count\">13건</span>":"6200 Series (Medium Load)<span class=\"series-count\">13 items</span>","6800 시리즈 (박형)<span class=\"series-count\">13건</span>":"6800 Series (Thin)<span class=\"series-count\">13 items</span>","6900 시리즈 (박형·대경)<span class=\"series-count\">13건</span>":"6900 Series (Thin, Large Bore)<span class=\"series-count\">13 items</span>","단위: mm · 치수는 deep_groove_ball.html의 동일 형번 규격과 같습니다.":"Unit: mm · Dimensions are the same as the corresponding model numbers' specifications on deep_groove_ball.html.","자동조심 볼 베어링(<a href=\"self_aligning_ball.html\" style=\"color: var(--accent);\">self_aligning_ball.html</a>) 1200~1206 구간은 세라믹 하이브리드로 표준 재고를 보유합니다(PEEK·플라스틱 사양은 별도 문의).":"Of the Self-Aligning Ball Bearings (<a href=\"self_aligning_ball.html\" style=\"color: var(--accent);\">self_aligning_ball.html</a>), we keep standard stock in ceramic hybrid for the 1200~1206 range (please inquire separately for PEEK/plastic specifications).","1200 시리즈<span class=\"series-count\">7건</span>":"1200 Series<span class=\"series-count\">7 items</span>","단위: mm · 치수는 self_aligning_ball.html의 동일 형번 규격과 같습니다.":"Unit: mm · Dimensions are the same as the corresponding model numbers' specifications on self_aligning_ball.html.","\n        ※ 위 치수는 각 표준 베어링 페이지(미니어처·딥그루브·자동조심)의 규격과 동일합니다.\n        표에 없는 사이즈의 하이브리드 사양이 필요하신 경우에도 견적 문의를 통해 가능 여부를 확인해드립니다.\n      ":"\n        ※ The dimensions above are the same as the specifications on each standard bearing page (Miniature, Deep Groove, Self-Aligning).\n        Even if you need a hybrid specification in a size not listed in the table, please contact us via quote inquiry and we will confirm availability.\n      ","[회사명] BEARING CO.":"[Company Name] BEARING CO.","\n          사업자등록번호 000-00-00000 · 대표 홍길동<br>\n          비공개 (문의 시 안내드립니다)\n        ":"\n          Business Registration No. 000-00-00000 · CEO Hong Gil-dong<br>\n          Not disclosed (available upon inquiry)\n        ","\n        <a href=\"introduce.html\">회사소개</a>\n        <a href=\"about-product.html\">취급제품</a>\n        <a href=\"board.html\">문의</a>\n      ":"\n        <a href=\"introduce.html\">Company</a>\n        <a href=\"about-product.html\">Products</a>\n        <a href=\"board.html\">Contact</a>\n      "},"ja":{"\n        <svg class=\"logo-mark\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n          <circle cx=\"20\" cy=\"20\" r=\"17\" stroke=\"#c98a2b\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"20\" r=\"8.5\" stroke=\"#4f7fb3\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"7\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"20\" cy=\"33\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n        </svg>\n        <span class=\"company-name\">\n          [회사명] 베어링\n          <span class=\"sub\">BEARING DISTRIBUTION</span>\n        </span>\n      ":"\n        <svg class=\"logo-mark\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n          <circle cx=\"20\" cy=\"20\" r=\"17\" stroke=\"#c98a2b\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"20\" r=\"8.5\" stroke=\"#4f7fb3\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"7\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"20\" cy=\"33\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n        </svg>\n        <span class=\"company-name\">\n          [会社名] ベアリング\n          <span class=\"sub\">ベアリング販売</span>\n        </span>\n      ","회사소개":"会社紹介","\n            <a href=\"introduce.html#greeting\">인사말</a>\n            <a href=\"introduce.html#history\">연혁</a>\n            <a href=\"introduce.html#directions\">찾아오시는 길</a>\n          ":"\n            <a href=\"introduce.html#greeting\">ごあいさつ</a>\n            <a href=\"introduce.html#history\">沿革</a>\n            <a href=\"introduce.html#directions\">アクセス</a>\n          ","취급제품":"取扱製品","\n            <a href=\"about-product.html#bearing-group\">베어링</a>\n            <a href=\"about-product.html#accessory-group\">부속 부품</a>\n            <a href=\"brands.html\">취급 브랜드</a>\n          ":"\n            <a href=\"about-product.html#bearing-group\">ベアリング</a>\n            <a href=\"about-product.html#accessory-group\">付属部品</a>\n            <a href=\"brands.html\">取扱ブランド</a>\n          ","규격검색":"規格検索","고객센터":"カスタマーセンター","\n            <a href=\"notice.html\">공지사항</a>\n            <a href=\"catalog.html\">카탈로그</a>\n            <a href=\"board.html\">견적문의</a>\n          ":"\n            <a href=\"notice.html\">お知らせ</a>\n            <a href=\"catalog.html\">カタログ</a>\n            <a href=\"board.html\">お見積り依頼</a>\n          ","\n          <a href=\"board.html\" class=\"btn btn-accent btn-sm\">견적 문의하기</a>\n        ":"\n          <a href=\"board.html\" class=\"btn btn-accent btn-sm\">お見積り依頼する</a>\n        ","\n        <p class=\"eyebrow\">Hybrid Bearings</p>\n        <h2>하이브리드 베어링</h2>\n        <p>\n          전동체(볼)만 비금속 소재로 바꾼 베어링으로, 전기 절연성·경량화·저마찰·내식성이 필요한 용도에 사용합니다.\n          아래 형번들은 일반 규격품과 함께 <strong style=\"color: var(--accent);\">당사가 표준으로 재고 보유하는 하이브리드 사양</strong>입니다.\n        </p>\n      ":"\n        <p class=\"eyebrow\">Hybrid Bearings</p>\n        <h2>ハイブリッドベアリング</h2>\n        <p>\n          転動体(ボール)のみを非金属材料に変更したベアリングで、電気絶縁性・軽量化・低摩擦・耐食性が必要な用途に使用します。\n          下記の形番は一般規格品とあわせて<strong style=\"color: var(--accent);\">当社が標準在庫として保有するハイブリッド仕様</strong>です。\n        </p>\n      ","형태 참고용 개념도 (SWS 카탈로그 실측 도면 아님) — 전동체(볼)만 비금속 소재로 교체한 구조, 정면도·측면도 측정 위치":"形状参考用概念図(SWSカタログの実測図面ではありません) — 転動体(ボール)のみを非金属材料に置き換えた構造、正面図・側面図の測定位置","\n        <img src=\"img/deep_groove_ball_open.png\" alt=\"일반 볼 베어링(개방형) 규격 도면 — D(외경)·d(내경)·B(폭) 측정 위치\" style=\"display: block; height: 208px; width: auto; max-width: 100%; object-fit: contain; image-rendering: -webkit-optimize-contrast;\" loading=\"lazy\">\n        <svg viewBox=\"0 0 375 236\" width=\"330\" height=\"208\" style=\"display: block;\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <circle cx=\"130\" cy=\"118\" r=\"78\" stroke=\"#333\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"130\" cy=\"118\" r=\"42\" stroke=\"#333\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"130\" cy=\"46\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-wi