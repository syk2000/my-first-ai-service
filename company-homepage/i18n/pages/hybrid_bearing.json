"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"77\" cy=\"65\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <line x1=\"183\" y1=\"65\" x2=\"245\" y2=\"32\" stroke=\"#666\" stroke-width=\"1\"></line>\n          <text x=\"249\" y=\"24\" font-size=\"12.5\" fill=\"#333\" font-weight=\"600\">転動体(ボール)</text>\n          <text x=\"249\" y=\"39\" font-size=\"11\" fill=\"#555\">セラミック・PEEK・</text>\n          <text x=\"249\" y=\"52\" font-size=\"11\" fill=\"#555\">プラスチックから選択</text>\n          <line x1=\"202\" y1=\"118\" x2=\"245\" y2=\"118\" stroke=\"#666\" stroke-width=\"1\"></line>\n          <text x=\"249\" y=\"114\" font-size=\"12.5\" fill=\"#333\" font-weight=\"600\">内外輪・保持器</text>\n          <text x=\"249\" y=\"129\" font-size=\"11\" fill=\"#555\">STB2鋼(標準と同一)</text>\n          <g stroke=\"#666\" stroke-width=\"1\">\n            <line x1=\"52\" y1=\"118\" x2=\"52\" y2=\"16\"></line>\n            <line x1=\"208\" y1=\"118\" x2=\"208\" y2=\"16\"></line>\n            <line x1=\"52\" y1=\"16\" x2=\"208\" y2=\"16\" marker-start=\"url(#hybArrow)\" marker-end=\"url(#hybArrow)\"></line>\n          </g>\n          <text x=\"130\" y=\"12\" text-anchor=\"middle\" font-size=\"14\" fill=\"#333\" font-weight=\"600\">D</text>\n          <g stroke=\"#666\" stroke-width=\"1\">\n            <line x1=\"88\" y1=\"118\" x2=\"88\" y2=\"220\"></line>\n            <line x1=\"172\" y1=\"118\" x2=\"172\" y2=\"220\"></line>\n            <line x1=\"88\" y1=\"220\" x2=\"172\" y2=\"220\" marker-start=\"url(#hybArrow)\" marker-end=\"url(#hybArrow)\"></line>\n          </g>\n          <text x=\"130\" y=\"233\" text-anchor=\"middle\" font-size=\"14\" fill=\"#333\" font-weight=\"600\">d</text>\n          <defs>\n            <marker id=\"hybArrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"3\" refY=\"3\" orient=\"auto\">\n              <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"#666\"></path>\n            </marker>\n          </defs>\n        </svg>\n        ","왼쪽은 일반 볼 베어링(개방형) 실제 규격 도면입니다 — D(외경)·d(내경)·B(폭) 측정 위치가 표시되어 있으며, 오른쪽은 하이브리드 구조 개념도입니다. 하이브리드 사양도 전동체(볼) 소재만 다를 뿐 외형 치수는 동일합니다. 전동체(볼)만 비금속 소재로 교체되며, 내외륜·리테이너는 일반 규격품과 동일(STB2강)입니다.":"左側は一般的な玉軸受(開放形)の実際の規格図面です — D(外径)・d(内径)・B(幅)の測定位置が示されており、右側はハイブリッド構造の概念図です。ハイブリッド仕様も転動体(ボール)の材質のみが異なり、外形寸法は同一です。転動体(ボール)のみが非金属材料に置き換えられ、内外輪・保持器は一般規格品と同一(STB2鋼)です。","\n        <strong>전동체(볼) 소재 종류</strong><br>\n        세라믹(풀세라믹 ZrO2) · PEEK 하이브리드 · 플라스틱(POM) 하이브리드<br>\n        <span style=\"color: var(--text-faint); font-size: 12.5px;\">내외륜·리테이너는 일반 사양과 동일(STB2강)이며, 볼만 교체한 사양입니다. 가격은 소재·수량에 따라 견적 문의로 안내해드립니다.</span>\n      ":"\n        <strong>転動体(ボール)素材の種類</strong><br>\n        セラミック(フルセラミック ZrO2)・PEEKハイブリッド・プラスチック(POM)ハイブリッド<br>\n        <span style=\"color: var(--text-faint); font-size: 12.5px;\">内外輪・保持器は一般仕様と同一(STB2鋼)で、ボールのみを交換した仕様です。価格は素材・数量によって異なりますので、お見積り依頼にてご案内いたします。</span>\n      ","\n        <button type=\"button\" class=\"cat-tab-btn active\" data-tab=\"hmini\">미니어처 볼 베어링</button>\n        <button type=\"button\" class=\"cat-tab-btn\" data-tab=\"hdg\">딥그루브 볼 베어링</button>\n        <button type=\"button\" class=\"cat-tab-btn\" data-tab=\"hsa\">자동조심 볼 베어링</button>\n      ":"\n        <button type=\"button\" class=\"cat-tab-btn active\" data-tab=\"hmini\">ミニチュアボールベアリング</button>\n        <button type=\"button\" class=\"cat-tab-btn\" data-tab=\"hdg\">深溝玉軸受</button>\n        <button type=\"button\" class=\"cat-tab-btn\" data-tab=\"hsa\">自動調心玉軸受</button>\n      ","미니어처 볼 베어링(<a href=\"miniature_ball.html\" style=\"color: var(--accent);\">miniature_ball.html</a>) 중 604·624·684·694 네 계열, 각 호칭 8번까지 세라믹·PEEK·플라스틱 하이브리드로 표준 재고를 보유합니다.":"ミニチュアボールベアリング(<a href=\"miniature_ball.html\" style=\"color: var(--accent);\">miniature_ball.html</a>)のうち604・624・684・694の4系列、各呼び番号8番までをセラミック・PEEK・プラスチックハイブリッドで標準在庫として保有しています。","604 시리즈 (표준폭)<span class=\"series-count\">5건</span>":"604シリーズ(標準幅)<span class=\"series-count\">5件</span>","형번":"型番","d(내경)":"d（内径）","D(외경)":"D（外径）","B(폭)":"B（幅）","하이브리드 소재":"ハイブリッド素材","624 시리즈 (광폭)<span class=\"series-count\">5건</span>":"624シリーズ(広幅)<span class=\"series-count\">5件</span>","684 시리즈 (초박형)<span class=\"series-count\">5건</span>":"684シリーズ(超薄形)<span class=\"series-count\">5件</span>","694 시리즈 (박형)<span class=\"series-count\">5건</span>":"694シリーズ(薄形)<span class=\"series-count\">5件</span>","단위: mm · 치수는 miniature_ball.html의 동일 형번 규격과 같습니다.":"単位: mm ・寸法はminiature_ball.htmlの同一形番規格と同じです。","딥그루브 볼 베어링(<a href=\"deep_groove_ball.html\" style=\"color: var(--accent);\">deep_groove_ball.html</a>) 중 6000·6200·6800·6900 네 계열, 각 12번까지 세라믹·PEEK·플라스틱 하이브리드로 표준 재고를 보유합니다(그 이상 호칭은 주문제작).":"深溝玉軸受(<a href=\"deep_groove_ball.html\" style=\"color: var(--accent);\">deep_groove_ball.html</a>)のうち6000・6200・6800・6900の4系列、各12番までをセラミック・PEEK・プラスチックハイブリッドで標準在庫として保有しています(それ以上の呼び番号は受注生産)。","6000 시리즈 (표준)<span class=\"series-count\">13건</span>":"6000シリーズ(標準)<span class=\"series-count\">13件</span>","6200 시리즈 (중하중)<span class=\"series-count\">13건</span>":"6200シリーズ(中荷重)<span class=\"series-count\">13件</span>","6800 시리즈 (박형)<span class=\"series-count\">13건</span>":"6800シリーズ(薄形)<span class=\"series-count\">13件</span>","6900 시리즈 (박형·대경)<span class=\"series-count\">13건</span>":"6900シリーズ(薄形・大径)<span class=\"series-count\">13件</span>","단위: mm · 치수는 deep_groove_ball.html의 동일 형번 규격과 같습니다.":"単位: mm ・寸法はdeep_groove_ball.htmlの同一形番規格と同じです。","자동조심 볼 베어링(<a href=\"self_aligning_ball.html\" style=\"color: var(--accent);\">self_aligning_ball.html</a>) 1200~1206 구간은 세라믹 하이브리드로 표준 재고를 보유합니다(PEEK·플라스틱 사양은 별도 문의).":"自動調心玉軸受(<a href=\"self_aligning_ball.html\" style=\"color: var(--accent);\">self_aligning_ball.html</a>)のうち1200~1206の区間はセラミックハイブリッドで標準在庫として保有しています(PEEK・プラスチック仕様は別途お問い合わせください)。","1200 시리즈<span class=\"series-count\">7건</span>":"1200シリーズ<span class=\"series-count\">7件</span>","단위: mm · 치수는 self_aligning_ball.html의 동일 형번 규격과 같습니다.":"単位: mm ・寸法はself_aligning_ball.htmlの同一形番規格と同じです。","\n        ※ 위 치수는 각 표준 베어링 페이지(미니어처·딥그루브·자동조심)의 규격과 동일합니다.\n        표에 없는 사이즈의 하이브리드 사양이 필요하신 경우에도 견적 문의를 통해 가능 여부를 확인해드립니다.\n      ":"\n        ※ 上記の寸法は各標準ベアリングページ(ミニチュア・深溝・自動調心)の規格と同一です。\n        表に記載のないサイズのハイブリッド仕様が必要な場合も、お見積り依頼にて対応可否をご案内いたします。\n      ","[회사명] BEARING CO.":"[会社名] BEARING CO.","\n          사업자등록번호 000-00-00000 · 대표 홍길동<br>\n          비공개 (문의 시 안내드립니다)\n        ":"\n          事業者登録番号 000-00-00000 ・ 代表 ホン・ギルドン<br>\n          非公開（お問い合わせ時にご案内します）\n        ","\n        <a href=\"introduce.html\">회사소개</a>\n        <a href=\"about-product.html\">취급제품</a>\n        <a href=\"board.html\">문의</a>\n      ":"\n        <a href=\"introduce.html\">会社紹介</a>\n        <a href=\"about-product.html\">取扱製品</a>\n        <a href=\"board.html\">お問い合わせ</a>\n      "},"zh":{"\n        <svg class=\"logo-mark\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n          <circle cx=\"20\" cy=\"20\" r=\"17\" stroke=\"#c98a2b\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"20\" r=\"8.5\" stroke=\"#4f7fb3\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"7\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"20\" cy=\"33\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n        </svg>\n        <span class=\"company-name\">\n          [회사명] 베어링\n          <span class=\"sub\">BEARING DISTRIBUTION</span>\n        </span>\n      ":"\n        <svg class=\"logo-mark\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n          <circle cx=\"20\" cy=\"20\" r=\"17\" stroke=\"#c98a2b\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"20\" r=\"8.5\" stroke=\"#4f7fb3\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"20\" cy=\"7\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"30.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"20\" cy=\"33\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"26\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n          <circle cx=\"9.5\" cy=\"14\" r=\"2.6\" fill=\"#eef2f6\"></circle>\n        </svg>\n        <span class=\"company-name\">\n          [公司名] 轴承\n          <span class=\"sub\">轴承经销</span>\n        </span>\n      ","회사소개":"公司介绍","\n            <a href=\"introduce.html#greeting\">인사말</a>\n            <a href=\"introduce.html#history\">연혁</a>\n            <a href=\"introduce.html#directions\">찾아오시는 길</a>\n          ":"\n            <a href=\"introduce.html#greeting\">致辞</a>\n            <a href=\"introduce.html#history\">沿革</a>\n            <a href=\"introduce.html#directions\">路线</a>\n          ","취급제품":"产品介绍","\n            <a href=\"about-product.html#bearing-group\">베어링</a>\n            <a href=\"about-product.html#accessory-group\">부속 부품</a>\n            <a href=\"brands.html\">취급 브랜드</a>\n          ":"\n            <a href=\"about-product.html#bearing-group\">轴承</a>\n            <a href=\"about-product.html#accessory-group\">配件</a>\n            <a href=\"brands.html\">经销品牌</a>\n          ","규격검색":"规格搜索","고객센터":"客户中心","\n            <a href=\"notice.html\">공지사항</a>\n            <a href=\"catalog.html\">카탈로그</a>\n            <a href=\"board.html\">견적문의</a>\n          ":"\n            <a href=\"notice.html\">公告</a>\n            <a href=\"catalog.html\">产品目录</a>\n            <a href=\"board.html\">询价</a>\n          ","\n          <a href=\"board.html\" class=\"btn btn-accent btn-sm\">견적 문의하기</a>\n        ":"\n          <a href=\"board.html\" class=\"btn btn-accent btn-sm\">立即询价</a>\n        ","\n        <p class=\"eyebrow\">Hybrid Bearings</p>\n        <h2>하이브리드 베어링</h2>\n        <p>\n          전동체(볼)만 비금속 소재로 바꾼 베어링으로, 전기 절연성·경량화·저마찰·내식성이 필요한 용도에 사용합니다.\n          아래 형번들은 일반 규격품과 함께 <strong style=\"color: var(--accent);\">당사가 표준으로 재고 보유하는 하이브리드 사양</strong>입니다.\n        </p>\n      ":"\n        <p class=\"eyebrow\">Hybrid Bearings</p>\n        <h2>混合轴承</h2>\n        <p>\n          仅将滚动体(钢球)更换为非金属材料的轴承,用于需要电气绝缘性、轻量化、低摩擦、耐腐蚀性的场合。\n          以下型号是本公司与常规标准产品一同<strong style=\"color: var(--accent);\">作为标准库存保有的混合轴承规格</strong>。\n        </p>\n      ","형태 참고용 개념도 (SWS 카탈로그 실측 도면 아님) — 전동체(볼)만 비금속 소재로 교체한 구조, 정면도·측면도 측정 위치":"形态参考用概念图(非SWS产品目录实测图纸) — 仅将滚动体(钢球)替换为非金属材料的结构,正视图·侧视图测量位置","\n        <img src=\"img/deep_groove_ball_open.png\" alt=\"일반 볼 베어링(개방형) 규격 도면 — D(외경)·d(내경)·B(폭) 측정 위치\" style=\"display: block; height: 208px; width: auto; max-width: 100%; object-fit: contain; image-rendering: -webkit-optimize-contrast;\" loading=\"lazy\">\n        <svg viewBox=\"0 0 375 236\" width=\"330\" height=\"208\" style=\"display: block;\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <circle cx=\"130\" cy=\"118\" r=\"78\" stroke=\"#333\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"130\" cy=\"118\" r=\"42\" stroke=\"#333\" stroke-width=\"2.5\"></circle>\n          <circle cx=\"130\" cy=\"46\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"183\" cy=\"65\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"202\" cy=\"118\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"183\" cy=\"171\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"130\" cy=\"190\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"77\" cy=\"171\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"58\" cy=\"118\" r=\"9\" fill=\"#efe3c4\" stroke=\"#333\" stroke-width=\"1.8\"></circle>\n          <circle cx=\"77\" cy=\"65\" r=\"9\" fill=\"#